{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jev-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI",
    "remote": true },
  "kv_namespaces": [{ "binding": "JEV_CACHE" }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "vars": {
    "JEV_PROVIDER": "workers-ai",
    "CONFIDENCE_AUTO": "0.9",
    "CONFIDENCE_REVIEW": "0.6",
    "CACHE_TTL_SECONDS": "3600",
    "UPSTREAM_TIMEOUT_MS": "15000",
    "BATCH_MAX_ITEMS": "20",
    "BATCH_CONCURRENCY": "4",
    "AUTH_ENABLED": "true",
    "ENVIRONMENT": "production",
    "CORS_ALLOWED_ORIGINS": "",
    "LOG_INPUTS": "false",
  },
}

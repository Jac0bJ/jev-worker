{
  "name": "jev-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A safe, cacheable HTTP API for TypeSafe Jev on Cloudflare Workers",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "deploy": "wrangler deploy",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.12.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.7",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.140.0"
  },
  "cloudflare": {
    "bindings": {
      "CLIENT_API_KEYS": {
        "description": "Required: a strong random client API key, or comma-separated keys. Generate one with openssl rand -hex 32."
      }
    }
  }
}
